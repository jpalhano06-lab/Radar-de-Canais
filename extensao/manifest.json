{
  "manifest_version": 3,
  "name": "Radar de Canais",
  "version": "0.58.0",
  "description": "Escreve em cima de cada vídeo quantas vezes ele passou do normal do canal, o selo do canal raro e a reação do público; lê os vídeos do YouTube enquanto você navega (sem gastar a cota) e guarda no Radar os que estouraram; resumo da busca, filtros dos vídeos da página e print do cartão; preenche sozinha a publicação no YouTube Studio (detalhes, anúncios e questionário), mostra o melhor horário do canal na hora de agendar, comprime a capa que passa de 2 MB e escreve a descrição e as tags do vídeo que não saiu da fábrica; a descrição do vídeo da fábrica já vem escrita do Radar, do mesmo minuto do roteiro.",
  "icons": {
    "16": "icones/16.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "48": "icones/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "scripting",
    "activeTab",
    "unlimitedStorage",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://i.ytimg.com/*",
    "https://*.canva.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ler.js",
        "leitor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "studio.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "studio-ponte.js",
        "publicar.js",
        "studio-lente.js",
        "anuncios.js",
        "horario.js",
        "painel-dia.js"
      ],
      "css": [
        "studio-lente.css",
        "anuncios.css",
        "horario.css",
        "painel-dia.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ler.js",
        "content.js",
        "painel-dia.js"
      ],
      "css": [
        "content.css",
        "painel-dia.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ],
      "js": [
        "sair.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "claude-projetos.js",
        "claude-sync.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "chat-radar.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "colar.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "salvar-canal": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Salvar no Radar o canal do vídeo aberto ou da página do canal"
    },
    "abrir-claude": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "Abrir ou fechar o Meu dia na beirada do YouTube"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dia.html",
        "dia.js",
        "dia-dados.js",
        "icones/48.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ]
}
